{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" },
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob: mediastream:; connect-src 'self' https: wss: http://192.168.4.1; frame-src 'self' https://accounts.google.com https://*.truelayer.com https://auth.truelayer.com https://auth.truelayer-sandbox.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/truelayer/callback",
        "function": {
          "functionId": "trueLayerCallback"
        }
      },
      {
        "source": "/api/google-drive/callback",
        "function": {
          "functionId": "googleDriveCallback"
        }
      },
      {
        "source": "/api/drive-photo",
        "function": {
          "functionId": "drivePhoto"
        }
      },
      {
        "source": "/api/google-photos/callback",
        "function": {
          "functionId": "googlePhotosCallback"
        }
      },
      {
        "source": "/api/gphotos-photo",
        "function": {
          "functionId": "gphotosPhoto"
        }
      },
      {
        "source": "/api/calendar/callback",
        "function": {
          "functionId": "googleCalendarCallback"
        }
      },
      {
        "source": "/api/marketing/callback",
        "function": {
          "functionId": "marketingConnectCallback"
        }
      },
      {
        "source": "/api/mail/callback",
        "function": {
          "functionId": "mailOAuthCallback"
        }
      },
      {
        "source": "/api/twilio/voice",
        "function": {
          "functionId": "twilioVoiceWebhook"
        }
      },
      {
        "source": "/api/twilio/sms",
        "function": {
          "functionId": "twilioSmsWebhook"
        }
      },
      {
        "source": "/api/twilio/status",
        "function": {
          "functionId": "twilioStatusWebhook"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint || echo Skipping-functions-lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    }
  }
}
