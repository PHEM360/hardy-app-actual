rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Returning a Path from a helper and passing it to firestore.get/exists
    // produces ||invalid_argument|| in Storage rules, which denies the write.
    // Receipts therefore cannot depend on Firestore lookups. This is a private
    // family app: any signed-in user may attach a receipt to a company they
    // can already write expenses for in Firestore.

    function isHouseholdAdmin(userDoc) {
      return userDoc.role == "admin" || userDoc.role == "Admin" ||
        userDoc.role == "superadmin" || userDoc.role == "Superadmin" ||
        userDoc.role == "super-admin" || userDoc.role == "super_admin" ||
        userDoc.isAdmin == true || userDoc.isSuperAdmin == true;
    }

    function canAccessHousehold(householdId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (
        request.auth.uid == householdId ||
        isHouseholdAdmin(userDoc) ||
        userDoc.householdId == householdId ||
        ('householdIds' in userDoc && householdId in userDoc.householdIds) ||
        (firestore.exists(/databases/(default)/documents/households/$(householdId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds)
      );
    }

    function canViewPageStorage(ownerId, page) {
      return request.auth != null && (
        request.auth.uid == ownerId ||
        firestore.exists(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid))
      );
    }

    function canEditPageStorage(ownerId, page) {
      return request.auth != null && (
        request.auth.uid == ownerId ||
        (firestore.exists(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid)).data.permission == "edit")
      );
    }

    match /tattersalls/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Expense receipts — signed-in users only. Do not call firestore.get here.
    match /companies/{companyId}/receipts/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /petDocuments/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /household/{householdId}/{allPaths=**} {
      allow read, write: if canAccessHousehold(householdId);
    }

    match /aiAnalysis/{userId}/{allPaths=**} {
      allow read: if canViewPageStorage(userId, "ai_analysis");
      allow write: if canEditPageStorage(userId, "ai_analysis");
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
