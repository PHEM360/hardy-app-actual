rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isHouseholdAdmin(userDoc) {
      return userDoc.role == "admin" || userDoc.role == "Admin" || userDoc.role == "superadmin" || userDoc.role == "Superadmin" || userDoc.isAdmin == true || userDoc.isSuperAdmin == true;
    }

    function canAccessHousehold(householdId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (
        request.auth.uid == householdId ||
        isHouseholdAdmin(userDoc) ||
        userDoc.householdId == householdId ||
        ('householdIds' in userDoc && householdId in userDoc.householdIds) ||
        (firestore.exists(/databases/(default)/documents/households/$(householdId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds)
      );
    }

    // Tattersalls documents — any authenticated user can read/write
    match /tattersalls/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    function canViewPageStorage(ownerId, page) {
      return request.auth != null && (
        request.auth.uid == ownerId ||
        firestore.exists(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid))
      );
    }

    function canEditPageStorage(ownerId, page) {
      return request.auth != null && (
        request.auth.uid == ownerId ||
        (firestore.exists(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid)).data.permission == "edit")
      );
    }
    // Mirrors firestore.rules' canAccessCompany: legacy (ownerless) companies
    // stay accessible to everyone during migration, otherwise a missing
    // ownerId field denied every write (this broke receipt uploads on
    // expenses for any company created before the ownerId model existed).
    function canAccessCompanyStorage(companyId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let c = firestore.get(/databases/(default)/documents/companies/$(companyId)).data;
      return request.auth != null && (
        isHouseholdAdmin(userDoc) ||
        !('ownerId' in c) ||
        c.ownerId == "" ||
        request.auth.uid == c.ownerId ||
        request.auth.uid in c.sharedWith ||
        canViewPageStorage(c.ownerId, "companies")
      );
    }

    function canEditCompanyStorage(companyId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let c = firestore.get(/databases/(default)/documents/companies/$(companyId)).data;
      return request.auth != null && (
        isHouseholdAdmin(userDoc) ||
        !('ownerId' in c) ||
        c.ownerId == "" ||
        request.auth.uid == c.ownerId ||
        request.auth.uid in c.sharedWith ||
        canEditPageStorage(c.ownerId, "companies")
      );
    }

    match /companies/{companyId}/receipts/{fileName} {
      allow read: if canAccessCompanyStorage(companyId);
      allow write: if canAccessCompanyStorage(companyId);
    }
    match /companies/{companyId}/{allPaths=**} {
      allow read: if canAccessCompanyStorage(companyId);
      allow write: if canEditCompanyStorage(companyId);
    }

    // Household item documents — shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/{allPaths=**} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // AI Analysis uploads — shareable via pageShares
    match /aiAnalysis/{userId}/{allPaths=**} {
      allow read: if canViewPageStorage(userId, "ai_analysis");
      allow write: if canEditPageStorage(userId, "ai_analysis");
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
