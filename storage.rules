rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tattersalls documents — any authenticated user can read/write
    match /tattersalls/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Company receipts — owner only
    match /companies/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Household item documents — owner only
    match /household/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
