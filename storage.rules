rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Returning a Path from a helper and passing it to firestore.get/exists
    // produces ||invalid_argument|| in Storage rules, which denies the write.
    // Receipts therefore cannot depend on Firestore lookups. This is a private
    // family app: any signed-in user may attach a receipt to a company they
    // can already write expenses for in Firestore.

    // Mirrors isOwnerAccount() in firestore.rules — that hardcoded-email bypass
    // grants the app owner superadmin there without ever needing a role/isAdmin
    // field on their own profile doc. Without an equivalent here, an owner
    // account with no such field set would pass every Firestore admin check
    // but still be denied by isHouseholdAdmin below on the Storage side.
    function isOwnerAccountStorage() {
      return request.auth.token.email == "chris.hardy.07@googlemail.com";
    }

    function isHouseholdAdmin(userDoc) {
      return isOwnerAccountStorage() ||
        userDoc.role == "admin" || userDoc.role == "Admin" ||
        userDoc.role == "superadmin" || userDoc.role == "Superadmin" ||
        userDoc.role == "super-admin" || userDoc.role == "super_admin" ||
        userDoc.isAdmin == true || userDoc.isSuperAdmin == true;
    }

    function isInteractiveUser() {
      return request.auth != null && !('deviceId' in request.auth.token);
    }

    function isActiveDisplayFor(userId) {
      return request.auth != null &&
        'deviceId' in request.auth.token &&
        request.auth.uid == userId &&
        firestore.get(/databases/(default)/documents/devices/$(request.auth.token.deviceId)).data.uid == userId &&
        firestore.get(/databases/(default)/documents/devices/$(request.auth.token.deviceId)).data.revoked != true;
    }

    // NOTE: deliberately does NOT trust users/{uid}.householdId / householdIds —
    // those are client-writable denormalizations (see useHouseholds.ts) and must
    // never be treated as proof of membership. The household doc's own
    // memberIds is the sole source of truth — mirrors canAccessHousehold in
    // firestore.rules, which must stay in sync with this copy.
    function canAccessHousehold(householdId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return isInteractiveUser() && (
        request.auth.uid == householdId ||
        isHouseholdAdmin(userDoc) ||
        (firestore.exists(/databases/(default)/documents/households/$(householdId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds)
      );
    }

    function canViewPageStorage(ownerId, page) {
      return isInteractiveUser() && (
        request.auth.uid == ownerId ||
        firestore.exists(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid))
      );
    }

    function canEditPageStorage(ownerId, page) {
      return isInteractiveUser() && (
        request.auth.uid == ownerId ||
        (firestore.exists(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/pageShares/$(ownerId + '_' + page + '_' + request.auth.uid)).data.permission == "edit")
      );
    }

    // Mirrors canAccessCompany/canEditCompany in firestore.rules — those start
    // with an isAdmin() bypass that this copy was missing, so an app admin who
    // isn't the company's owner and isn't in sharedWith could edit a company's
    // Firestore records but then have a receipt/document upload rejected here.
    function canViewCompanyStorage(companyId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let company = firestore.get(/databases/(default)/documents/companies/$(companyId)).data;
      return isInteractiveUser() && (
        isHouseholdAdmin(userDoc) ||
        !('ownerId' in company) ||
        company.ownerId == "" ||
        request.auth.uid == company.ownerId ||
        ('sharedWith' in company && request.auth.uid in company.sharedWith) ||
        canViewPageStorage(company.ownerId, "companies")
      );
    }

    function canEditCompanyStorage(companyId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let company = firestore.get(/databases/(default)/documents/companies/$(companyId)).data;
      return isInteractiveUser() && (
        isHouseholdAdmin(userDoc) ||
        !('ownerId' in company) ||
        company.ownerId == "" ||
        request.auth.uid == company.ownerId ||
        ('sharedWith' in company && request.auth.uid in company.sharedWith) ||
        canEditPageStorage(company.ownerId, "companies")
      );
    }

    function validNoteMedia() {
      return request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('(image|video|audio)/.*');
    }

    match /tattersalls/{allPaths=**} {
      allow read, write: if isInteractiveUser();
    }

    match /flats/{flatId}/{allPaths=**} {
      allow read, write: if isInteractiveUser();
    }

    // Company files use the same owner/share model as the company document.
    match /companies/{companyId}/receipts/{fileName} {
      allow read: if canViewCompanyStorage(companyId);
      allow write: if canEditCompanyStorage(companyId);
    }
    match /companies/{companyId}/documents/{fileName} {
      allow read: if canViewCompanyStorage(companyId);
      allow write: if canEditCompanyStorage(companyId);
    }
    match /companies/{companyId}/marketing/{fileName} {
      allow read: if canViewCompanyStorage(companyId);
      allow create, update: if canEditCompanyStorage(companyId) &&
        request.resource.size < 1024 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('(image|video|application)/.*') ||
          request.resource.contentType.size() < 1
        );
      allow delete: if canEditCompanyStorage(companyId);
    }
    match /companies/{companyId}/taxreturns/{fileName} {
      allow read: if canViewCompanyStorage(companyId);
      allow write: if canEditCompanyStorage(companyId);
    }
    // Logos are uploaded while the company form is still being completed, so
    // there is no company document to authorise against yet.
    match /companies/logos/{fileName} {
      allow read, write: if isInteractiveUser();
    }

    match /documents/{userId}/{allPaths=**} {
      allow read, write: if isInteractiveUser() && request.auth.uid == userId;
    }
    match /captureInbox/{userId}/{allPaths=**} {
      allow read, write: if isInteractiveUser() && request.auth.uid == userId;
    }
    match /petDocuments/{userId}/{allPaths=**} {
      allow read, write: if isInteractiveUser() && request.auth.uid == userId;
    }

    match /household/{householdId}/{allPaths=**} {
      allow read, write: if canAccessHousehold(householdId);
    }

    match /aiAnalysis/{userId}/{allPaths=**} {
      allow read: if canViewPageStorage(userId, "ai_analysis");
      allow write: if canEditPageStorage(userId, "ai_analysis");
    }

    match /photos/{userId}/{albumId}/{fileName} {
      allow read: if canViewPageStorage(userId, "photos") || isActiveDisplayFor(userId) ||
        (request.auth != null &&
          firestore.exists(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)).data.sharedWith);
      allow create, update: if request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*') && (
          canEditPageStorage(userId, "photos") ||
          (isInteractiveUser() &&
            firestore.exists(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)) &&
            'editors' in firestore.get(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)).data &&
            request.auth.uid in firestore.get(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)).data.editors)
        );
      allow delete: if canEditPageStorage(userId, "photos") ||
        (isInteractiveUser() &&
          firestore.exists(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)) &&
          'editors' in firestore.get(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)).data &&
          request.auth.uid in firestore.get(/databases/(default)/documents/photos/$(userId)/albums/$(albumId)).data.editors);
    }

    match /displayPhotos/{userId}/{fileName} {
      allow read: if (isInteractiveUser() && request.auth.uid == userId) || isActiveDisplayFor(userId);
      allow create, update: if isInteractiveUser() &&
        request.auth.uid == userId &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isInteractiveUser() && request.auth.uid == userId;
    }

    match /hubNotes/{userId}/media/{noteId}/{fileName} {
      allow read: if canViewPageStorage(userId, "notes") ||
        (isInteractiveUser() &&
          firestore.exists(/databases/(default)/documents/hubNotes/$(userId)/items/$(noteId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/hubNotes/$(userId)/items/$(noteId)).data.sharedWith);
      allow write: if validNoteMedia() && (
        canEditPageStorage(userId, "notes") ||
          (isInteractiveUser() &&
            firestore.exists(/databases/(default)/documents/hubNotes/$(userId)/items/$(noteId)) &&
            request.auth.uid in firestore.get(/databases/(default)/documents/hubNotes/$(userId)/items/$(noteId)).data.sharedWith &&
            firestore.get(/databases/(default)/documents/hubNotes/$(userId)/items/$(noteId)).data.sharePermission == "edit")
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
