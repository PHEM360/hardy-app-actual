rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tattersalls documents — any authenticated user can read/write
    match /tattersalls/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Company receipts & tax return PDFs — owner or shared users only
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == firestore.get(/databases/(default)/documents/companies/$(companyId)).data.ownerId ||
        request.auth.uid in firestore.get(/databases/(default)/documents/companies/$(companyId)).data.sharedWith
      );
    }

    // Household item documents — owner only
    match /household/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
