rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    // QR-paired /display devices carry a `deviceId` custom claim (minted in
    // claimDevicePairing). If that device has since been revoked (Settings ->
    // Linked Displays -> Forget), its session is cut off here — this is the
    // one real enforcement point, not just a cooperative client-side check.
    // Normal sessions never carry this claim, so the `!('deviceId' in ...)`
    // branch short-circuits before the extra get() runs — zero added cost
    // for every non-device session.
    function isFirebaseAuthenticated() {
      return request.auth != null &&
        (!('deviceId' in request.auth.token) ||
          !get(/databases/$(database)/documents/devices/$(request.auth.token.deviceId)).data.get('revoked', false));
    }

    function hasDisplayClaim() {
      return request.auth != null && 'deviceId' in request.auth.token;
    }

    function isActiveDisplayFor(userId) {
      return isFirebaseAuthenticated() &&
        hasDisplayClaim() &&
        request.auth.uid == userId &&
        get(/databases/$(database)/documents/devices/$(request.auth.token.deviceId)).data.uid == userId;
    }

    // Interactive app users must enrol a passkey before normal application
    // data becomes available. Display credentials are deliberately excluded
    // and granted read-only access only to explicitly display-safe paths.
    function isAuthenticated() {
      return isFirebaseAuthenticated() &&
        !hasDisplayClaim() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('passkeyEnrolled', false) == true;
    }

    function isFirebaseOwner(userId) {
      return isFirebaseAuthenticated() && request.auth.uid == userId;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOwnerAccount() {
      return isAuthenticated() && request.auth.token.email == "chris.hardy.07@googlemail.com";
    }

    function userDocExists() {
      return isFirebaseAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function securitySettingsExist() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/security/settings);
    }

    function defaultModuleRequirement(moduleId) {
      return moduleId == "personal_finance" || moduleId == "passwords" ? "passkey" : "none";
    }

    function moduleRequirement(moduleId) {
      return securitySettingsExist()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)/security/settings)
            .data.get("moduleRequirements", {}).get(moduleId, defaultModuleRequirement(moduleId))
        : defaultModuleRequirement(moduleId);
    }

    function hasRecentPasskey() {
      return isAuthenticated() &&
        request.auth.token.get("passkeyVerifiedAt", 0) >
          (request.time.toMillis() / 1000) - 300;
    }

    function modulePasskeyFreshnessDays() {
      let requestedDays = securitySettingsExist()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)/security/settings)
            .data.get("appUnlockIntervalDays", 7)
        : 7;
      let settingsVersion = securitySettingsExist()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)/security/settings)
            .data.get("version", 1)
        : 2;
      let migratedDays = settingsVersion < 2 && requestedDays == 30 ? 7 : requestedDays;
      return migratedDays < 1 ? 1 : migratedDays > 365 ? 365 : migratedDays;
    }

    function hasFreshModulePasskey() {
      return isAuthenticated() &&
        request.auth.token.get("passkeyVerifiedAt", 0) >
          (request.time.toMillis() / 1000) - (modulePasskeyFreshnessDays() * 86400);
    }

    function hasRecentPassword() {
      return isAuthenticated() &&
        request.auth.token.get("auth_time", 0) >
          (request.time.toMillis() / 1000) - 300 &&
        request.auth.token.get("firebase", {}).get("sign_in_provider", "") == "password";
    }

    function meetsModuleSecurity(moduleId) {
      // Log Ins vault is end-to-end encrypted and unlocked with a vault PIN /
      // device biometrics. Requiring a separate page passkey caused a double
      // prompt and blocked PIN-only unlock from reading ciphertext.
      let requirement = moduleRequirement(moduleId);
      return moduleId == "passwords"
        ? isAuthenticated()
        : (
          requirement == "none" ||
          (requirement == "passkey" && hasFreshModulePasskey()) ||
          (requirement == "password" && hasRecentPassword())
        );
    }

    function moduleForPage(page) {
      return page == "finance" ? "personal_finance" :
        page == "login_details" ? "passwords" :
        page == "health" ? "health" :
        page == "notes" ? "notes" :
        page == "companies" ? "companies" :
        page == "pets" ? "pets" :
        page == "tasks" ? "tasks" :
        page == "calendar" ? "calendar" :
        page == "inheritance" ? "inheritance" :
        page == "qrcodes" ? "qr_codes" :
        page;
    }

    function isSuperAdmin() {
      return isOwnerAccount() || (isAuthenticated() && userDocExists() && (
        userDoc().get('role', '') == "superadmin" ||
        userDoc().get('role', '') == "Superadmin" ||
        userDoc().get('role', '') == "super_admin" ||
        userDoc().get('isSuperAdmin', false) == true
      ));
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userDocExists() && (
          userDoc().get('role', '') == "admin" ||
          userDoc().get('role', '') == "Admin" ||
          userDoc().get('isAdmin', false) == true
        ))
      );
    }

    // `uid in data.sharedWith` errors when the field is missing, which denies
    // the whole rule before later OR clauses (page shares) can run.
    function sharedWithHasUid(data) {
      return request.auth.uid in data.get('sharedWith', []);
    }

    // Generic per-page individual sharing: pageShares/{ownerId}_{page}_{targetUid}
    // grants the target user "view" or "edit" access to one of the owner's
    // pages (finance, tasks, etc.) without touching household membership.
    function pageShareId(ownerId, page) {
      return ownerId + '_' + page + '_' + request.auth.uid;
    }

    function canViewPage(ownerId, page) {
      return isAuthenticated() && meetsModuleSecurity(moduleForPage(page)) && (
        isOwner(ownerId) ||
        isAdmin() ||
        exists(/databases/$(database)/documents/pageShares/$(pageShareId(ownerId, page)))
      );
    }

    function canEditPage(ownerId, page) {
      return isAuthenticated() && meetsModuleSecurity(moduleForPage(page)) && (
        isOwner(ownerId) ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/pageShares/$(pageShareId(ownerId, page))) &&
          get(/databases/$(database)/documents/pageShares/$(pageShareId(ownerId, page))).data.permission == "edit")
      );
    }

    // Shared-ownership helper for companies (and their subcollections/settings):
    // legacy (ownerless) companies stay visible to everyone during migration.
    function canAccessCompany(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return isAdmin() ||
        !('ownerId' in c) ||
        c.ownerId == "" ||
        request.auth.uid == c.ownerId ||
        sharedWithHasUid(c) ||
        canViewPage(c.ownerId, "companies");
    }

    function canEditCompany(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return isAdmin() ||
        !('ownerId' in c) ||
        c.ownerId == "" ||
        request.auth.uid == c.ownerId ||
        sharedWithHasUid(c) ||
        canEditPage(c.ownerId, "companies");
    }

    // Shared-ownership helper for pets (and their subcollections, e.g. dog
    // tags) — same model as canAccessCompany: legacy (ownerless) pets stay
    // visible to everyone during migration.
    function canAccessPet(petId) {
      let p = get(/databases/$(database)/documents/pets/$(petId)).data;
      return isAdmin() ||
        !('ownerId' in p) ||
        p.ownerId == "" ||
        request.auth.uid == p.ownerId ||
        sharedWithHasUid(p) ||
        canViewPage(p.ownerId, "pets");
    }

    function canAccessHousehold(householdId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == householdId ||
        userDoc.householdId == householdId ||
        ('householdIds' in userDoc && householdId in userDoc.householdIds) ||
        (exists(/databases/$(database)/documents/households/$(householdId)) &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds)
      );
    }

    // Users collection - users can read/write their own data, admins can manage all
    match /users/{userId} {
      allow read: if isAuthenticated() || (isFirebaseOwner(userId) && !hasDisplayClaim());
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(userId) || isAdmin();
      // Don't allow direct client writes to other users' docs unless they're admin.
      // Superadmin/admin actions should prefer Cloud Functions.

      // Password-vault configuration contains the encrypted private key and is
      // deliberately owner-only. Admin status never bypasses this boundary.
      match /vault/{vaultDoc} {
        allow read, write: if isOwner(userId);
      }

      // 1Password Connect credentials for bidirectional login sync (owner-only).
      match /integrations/{integrationId} {
        allow read, write: if isOwner(userId);
      }

      // OAuth tokens and other secrets — Admin SDK / Cloud Functions only.
      match /secrets/{secretId} {
        allow read, write: if false;
      }

      // Each user controls their own app/session and per-module requirements.
      match /security/{securityDoc} {
        allow read: if isFirebaseOwner(userId);
        allow write: if isOwner(userId) && hasRecentPasskey();
      }
    }

    // Short-lived Google Drive OAuth state — Functions only.
    match /googleDriveOAuthStates/{stateId} {
      allow read, write: if false;
    }

    // Picture albums (Google Drive sync). Metadata writes go through callables;
    // interactive users and paired displays may read albums they own or are shared into.
    match /pictureAlbums/{albumId} {
      function albumReadable() {
        return isFirebaseAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.get('shareUids', [])
        );
      }

      allow read: if albumReadable();
      allow write: if false;

      match /photos/{photoId} {
        allow read: if isFirebaseAuthenticated() && (
          get(/databases/$(database)/documents/pictureAlbums/$(albumId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/pictureAlbums/$(albumId)).data.get('shareUids', [])
        );
        allow write: if false;
      }
    }

    // Passkey public keys and one-time challenges are read and written only by
    // server-side WebAuthn verification functions.
    match /passkeys/{credentialId} {
      allow read, write: if false;
    }

    match /passkeyChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /passkeyRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Public RSA keys let users encrypt an individual credential key for its
    // recipient. No private or PIN-derived material is stored here.
    match /vaultPublicKeys/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(userId);
    }
    
    // Invites collection - only admins can manage
    match /invites/{inviteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Households - formal multi-membership entity. Any current member can read/
    // update (e.g. invite another member); only the creator or an admin can
    // delete the household itself.
    match /households/{householdId} {
      allow read, update: if isAuthenticated() && (
        isAdmin() || request.auth.uid in resource.data.memberIds
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.createdBy == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || request.auth.uid == resource.data.createdBy
      );
    }

    // Page shares - generic owner -> target grant (view/edit) for individual
    // pages (finance, tasks, etc). Doc id is deterministic: {ownerId}_{page}_{targetUid}.
    match /pageShares/{shareId} {
      allow read, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        shareId == request.resource.data.ownerId + '_' + request.resource.data.page + '_' + request.resource.data.targetUid;
      allow update: if isAuthenticated() && (
        isAdmin() || resource.data.ownerId == request.auth.uid
      );
    }

    // Family collection - authenticated users can read, owners can write
    match /families/{familyId} {
      allow read: if isAuthenticated() && 
        (resource.data.members[request.auth.uid] != null || 
         resource.data.admins[request.auth.uid] != null);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.admins[request.auth.uid] == true;
      
      // Family members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null;
        allow write: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.admins[request.auth.uid] == true;
      }
      
      // Family documents subcollection
      match /documents/{documentId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null;
        allow write: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null;
      }
    }
    
    // Shared documents - only accessible by specified users
    match /sharedDocuments/{documentId} {
      allow read: if isAuthenticated() && 
        (resource.data.sharedWith[request.auth.uid] != null || 
         isOwner(resource.data.ownerId));
      allow write: if isAuthenticated() && isOwner(resource.data.ownerId);
    }
    
    // Pets collection - per-user with optional sharing
    // Legacy pets (no ownerId) remain readable by all authenticated users during migration
    // Pets collection - owner + sharedWith, or a pets pageShare, or 35PFP legacy (no ownerId)
    match /pets/{petId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        sharedWithHasUid(resource.data) ||
        canViewPage(resource.data.ownerId, "pets")
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        sharedWithHasUid(resource.data) ||
        canEditPage(resource.data.ownerId, "pets")
      );
      allow delete: if isAuthenticated() && (
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId
      );

      // Dog tags — printable QR stickers for this pet. No public rule here:
      // the /tag/:tagId scan page (hit by strangers with no account) never
      // talks to Firestore directly, only through Cloud Functions using the
      // Admin SDK — see functions/src/dogTags.ts.
      match /tags/{tagId} {
        allow read, write: if isAuthenticated() && canAccessPet(petId);
      }
    }

    // Dog tag friendly URLs (hardyapp.co.uk/p/{slug}). Uniqueness is enforced
    // by this rule alone, not application code: allow create only requires
    // being signed in (no way to check ownership before the doc exists), but
    // once a slug is claimed, only its owner can update/delete it — so a
    // second attempt to write over an already-claimed slug is treated as an
    // update by Firestore (the doc now exists) and denied unless it's the
    // same owner. First write wins.
    match /dogTagSlugs/{slug} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // QR code friendly/auto-generated links (hardyapp.co.uk/l/{slug}). Same
    // first-write-wins uniqueness pattern as dogTagSlugs above, but public
    // read: unlike dog tags, resolution happens client-side (no Cloud
    // Function) by reading this doc directly from an anonymous scanner, and
    // the only data exposed is the redirect target — no more sensitive than
    // the QR code itself.
    match /qrLinkSlugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Finance - each user's personal accounts, shareable via pageShares
    match /finance/{userId}/accounts/{accountId} {
      allow read: if canViewPage(userId, "finance");
      allow write: if canEditPage(userId, "finance");
    }

    match /finance/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "finance");
      allow write: if canEditPage(userId, "finance");
    }

    match /finance/{userId}/settings/{doc} {
      allow read: if canViewPage(userId, "finance");
      allow write: if canEditPage(userId, "finance");
    }

    // Bank-link metadata (TrueLayer). Tokens live in bankSecrets and are
    // Functions/Admin SDK only — clients can see connection status & mappings.
    match /finance/{userId}/bankConnections/{connId} {
      allow read: if canViewPage(userId, "finance");
      allow write: if false;
    }
    match /finance/{userId}/bankSecrets/{connId} {
      allow read, write: if false;
    }

    match /trueLayerOAuth/{stateId} {
      allow read, write: if false;
    }

    // Weight tracking - per user, bundled into the "health" page share
    // (weight, medications, health profile & health documents share one grant)
    match /weightTracker/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/height/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/botox/{recordId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/bloodPressure/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/measurements/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // Medications - per user, bundled into the "health" page share
    match /medications/{userId}/meds/{medId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /medications/{userId}/logs/{logId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // Notifications - per user
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Tattersalls - shared flat management data
    match /tattersalls/{docId} {
      allow read, write: if isAuthenticated();
      
      match /documents/{documentId} {
        allow read, write: if isAuthenticated();
      }
      
      match /notes/{noteId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /flats/{flatId} {
      allow read, write: if isAuthenticated();
      match /documents/{documentId} { allow read, write: if isAuthenticated(); }
      match /notes/{noteId} { allow read, write: if isAuthenticated(); }
    }

    // Tasks - per user, shareable via pageShares
    match /tasks/{userId}/items/{taskId} {
      allow read: if canViewPage(userId, "tasks") || isActiveDisplayFor(userId);
      allow write: if canEditPage(userId, "tasks");
    }

    // Task settings - strictly per user (not shared alongside the Tasks page)
    match /taskSettings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Password-vault records are ciphertext. Owners may migrate legacy records,
    // but shared users can only read records after client-side encryption.
    // Admins do not receive implicit vault access.
    match /users/{userId}/credentials/{credId} {
      allow read: if isAuthenticated() && meetsModuleSecurity("passwords") && (
        isOwner(userId) ||
        (
          resource.data.encrypted == true &&
          (
            (
              exists(/databases/$(database)/documents/pageShares/$(pageShareId(userId, "login_details"))) &&
              get(/databases/$(database)/documents/pageShares/$(pageShareId(userId, "login_details"))).data.targetUid == request.auth.uid
            ) ||
            (
              'individualAccess' in resource.data &&
              request.auth.uid in resource.data.individualAccess
            )
          )
        )
      );
      allow create: if isOwner(userId) && meetsModuleSecurity("passwords") &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.encrypted == true;
      allow update: if (isOwner(userId) && meetsModuleSecurity("passwords")) || (
        isAuthenticated() &&
        meetsModuleSecurity("passwords") &&
        resource.data.encrypted == true &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cipher', 'updatedAt']) &&
        (
          (
            exists(/databases/$(database)/documents/pageShares/$(pageShareId(userId, "login_details"))) &&
            get(/databases/$(database)/documents/pageShares/$(pageShareId(userId, "login_details"))).data.permission == "edit"
          ) ||
          (
            'individualEditors' in resource.data &&
            request.auth.uid in resource.data.individualEditors
          )
        )
      );
      allow delete: if isOwner(userId) && meetsModuleSecurity("passwords");
    }

    // Companies - shared via ownerId + sharedWith, or a companies pageShare.
    // Legacy companies (no ownerId) remain readable by all authenticated users during migration.
    match /companies/{companyId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        sharedWithHasUid(resource.data) ||
        canViewPage(resource.data.ownerId, "companies")
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        sharedWithHasUid(resource.data) ||
        canEditPage(resource.data.ownerId, "companies")
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId
      );

      match /logins/{loginId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /services/{serviceId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /expenses/{expenseId} {
        allow read, create, update: if isAuthenticated() && canAccessCompany(companyId);
        allow delete: if isAuthenticated() && canEditCompany(companyId);
      }
      match /insurance/{policyId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /income/{incomeId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /taxReturns/{returnId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /marketing/{documentId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /campaigns/{campaignId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /marketingAssets/{assetId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if isAuthenticated() && canEditCompany(companyId);
      }
      match /marketingAudits/{auditId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow delete: if isAuthenticated() && canEditCompany(companyId);
        allow create, update: if false;
      }
      match /content/{contentId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow create: if isAuthenticated() &&
          canEditCompany(companyId) &&
          request.resource.data.status in ['suggestion', 'draft', 'awaiting_approval'];
        allow update: if isAuthenticated() && canEditCompany(companyId) && (
          request.resource.data.status in ['suggestion', 'draft', 'rejected', 'cancelled'] ||
          (
            request.resource.data.status == 'awaiting_approval' &&
            request.resource.data.approvalVersion == resource.data.approvalVersion + 1 &&
            request.resource.data.approvedVersion == 0
          )
        );
        allow delete: if isAuthenticated() && canEditCompany(companyId);
      }
      // OAuth tokens are never stored here. This contains only account labels
      // and connection health written by trusted Cloud Functions.
      match /platformConnections/{connectionId} {
        allow read: if isAuthenticated() && canAccessCompany(companyId);
        allow write: if false;
      }
    }

    // Publishing jobs and encrypted platform credentials are server-only.
    match /marketingPublishJobs/{jobId} {
      allow read, write: if false;
    }
    match /marketingPlatformCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Company settings (income/expense categories, tax rate) - same sharing model as companies
    match /companySettings/{companyId} {
      allow read: if isAuthenticated() && canAccessCompany(companyId);
      allow write: if isAuthenticated() && canEditCompany(companyId);
    }

    // Household items - shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/items/{itemId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Household settings - shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/settings/{settingId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Freezer inventory - per user, shareable via pageShares
    match /freezer/{userId}/items/{itemId} {
      allow read: if canViewPage(userId, "freezer");
      allow write: if canEditPage(userId, "freezer");
    }

    // Hub notes (Keep/Notion-style workspace) — separate from Tattersalls notes
    match /hubNotes/{userId}/folders/{folderId} {
      allow read: if canViewPage(userId, "notes") ||
        (isAuthenticated() && "sharedWith" in resource.data && request.auth.uid in resource.data.sharedWith);
      allow create: if canEditPage(userId, "notes");
      allow update: if canEditPage(userId, "notes") ||
        (isAuthenticated() && "sharedWith" in resource.data && request.auth.uid in resource.data.sharedWith &&
          resource.data.get("sharePermission", "view") == "edit");
      allow delete: if isOwner(userId) || isAdmin();
    }
    match /hubNotes/{userId}/items/{noteId} {
      allow read: if canViewPage(userId, "notes") ||
        (isAuthenticated() && "sharedWith" in resource.data && request.auth.uid in resource.data.sharedWith);
      allow create: if canEditPage(userId, "notes");
      allow update: if canEditPage(userId, "notes") ||
        (isAuthenticated() && "sharedWith" in resource.data && request.auth.uid in resource.data.sharedWith &&
          resource.data.get("sharePermission", "view") == "edit");
      allow delete: if isOwner(userId) || isAdmin();
    }
    match /hubNotes/{userId}/vault/{noteId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /hubNotes/{userId}/settings/{docId} {
      allow read: if docId == "vault"
        ? (isOwner(userId) || isAdmin())
        : canViewPage(userId, "notes");
      allow write: if docId == "vault"
        ? (isOwner(userId) || isAdmin())
        : canEditPage(userId, "notes");
    }
    match /noteGrants/{grantId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
    }

    // QR codes library - per user, shareable via pageShares
    match /qrcodes/{userId}/items/{qrId} {
      allow read: if canViewPage(userId, "qrcodes");
      allow write: if canEditPage(userId, "qrcodes");
    }

    // QR code settings - shared alongside the QR codes page
    match /qrcodes/{userId}/settings/{doc} {
      allow read: if canViewPage(userId, "qrcodes");
      allow write: if canEditPage(userId, "qrcodes");
    }

    // Calendar events - per user, shareable via pageShares
    match /calendar/{userId}/events/{eventId} {
      allow read: if canViewPage(userId, "calendar") || isActiveDisplayFor(userId);
      allow write: if canEditPage(userId, "calendar");
    }

    // Calendar meta/settings - shared alongside the Calendar page
    match /calendar/{userId}/meta/{doc} {
      allow read: if canViewPage(userId, "calendar") || isActiveDisplayFor(userId);
      allow write: if canEditPage(userId, "calendar");
    }

    // Annual leave - per user rotation periods & leave entries, shareable via pageShares
    match /annualLeave/{userId}/periods/{periodId} {
      allow read: if canViewPage(userId, "annual_leave");
      allow write: if canEditPage(userId, "annual_leave");
    }
    match /annualLeave/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "annual_leave");
      allow write: if canEditPage(userId, "annual_leave");
    }

    // Holidays price watches - per user, shareable via pageShares
    match /holidays/{userId}/watches/{watchId} {
      allow read: if canViewPage(userId, "holidays");
      allow write: if canEditPage(userId, "holidays");

      match /prices/{priceId} {
        allow read: if canViewPage(userId, "holidays");
        allow write: if canEditPage(userId, "holidays");
      }
    }
    match /holidays/{userId}/meta/{docId} {
      allow read: if canViewPage(userId, "holidays");
      allow write: if canEditPage(userId, "holidays");
    }

    // Substances config - TOTP setup per user - strictly private, never shared
    match /substancesConfig/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Health profile - demographics & medical history per user, bundled into the "health" page share
    match /healthProfile/{userId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    match /wearableHealth/{userId}/daily/{dayId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /wearableHealth/{userId}/sources/{sourceId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // App-wide config (e.g. Gemini API key) - readable/writable by any authenticated user
    match /appConfig/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Custom health tabs - per user, bundled into the "health" page share
    match /healthTabs/{userId}/tabs/{tabId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /healthTabs/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // Substance logs - per user, bundled into the "health" page share
    match /substanceLogs/{userId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
      match /logs/{logId} {
        allow read: if canViewPage(userId, "health");
        allow write: if canEditPage(userId, "health");
      }
    }

    // Cameras - shared by household membership, with owner-uid fallback for legacy data
    match /cameras/{householdId} {
      allow read, write: if canAccessHousehold(householdId);
      match /list/{camId} {
        allow read, write: if canAccessHousehold(householdId);
      }
    }

    // Household documents - shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/documents/{docId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // /display photo frame library - shared by household membership, same as household items/documents
    match /household/{householdId}/photos/{photoId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    match /household/{householdId}/messages/{messageId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Joint household finance — shared with every household member (not personal finance/{uid})
    match /household/{householdId}/financeAccounts/{accountId} {
      allow read, write: if canAccessHousehold(householdId);
    }
    match /household/{householdId}/financeEntries/{entryId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Notification preferences - per user
    match /notificationPrefs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Scheduled notifications - written by Cloud Functions; readable by owner
    match /scheduledNotifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Security posture reports — written by Cloud Functions; readable by admins
    match /securityReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /securityScanPrefs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // General document store - per user, shareable via pageShares
    match /documents/{userId}/items/{docId} {
      allow read: if canViewPage(userId, "documents");
      allow write: if canEditPage(userId, "documents");
    }

    // AI Analysis session history - shareable via pageShares
    match /aiAnalysis/{userId}/sessions/{sessionId} {
      allow read: if canViewPage(userId, "ai_analysis");
      allow write: if canEditPage(userId, "ai_analysis");
    }

    // Always-on display devices — a device authenticates as the real account
    // that paired/signed it in, so it can only ever touch its own doc here
    // (not create/read others'). Creation happens either client-side right
    // after the device's own sign-in (uid must match), or via the pairing
    // Cloud Functions using the Admin SDK, which bypasses these rules.
    match /devices/{deviceId} {
      allow read: if isFirebaseAuthenticated() && request.auth.uid == resource.data.uid;
      allow update: if (
        isAuthenticated() && request.auth.uid == resource.data.uid
      ) || (
        isActiveDisplayFor(resource.data.uid) &&
        request.auth.token.deviceId == deviceId &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings']) &&
            request.resource.data.settings.diff(resource.data.settings).affectedKeys().hasOnly(['alarms', 'nightMode'])
          )
        )
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
      allow create: if false;
    }

    // Account-scoped photo library exposed only to the owning account and its
    // securely paired display sessions (which authenticate as that account).
    match /displayPhotos/{userId}/items/{photoId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isActiveDisplayFor(userId);
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
