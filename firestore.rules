rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    // QR-paired /display devices carry a `deviceId` custom claim (minted in
    // claimDevicePairing). If that device has since been revoked (Settings ->
    // Linked Displays -> Forget), its session is cut off here — this is the
    // one real enforcement point, not just a cooperative client-side check.
    // Normal sessions never carry this claim, so the `!('deviceId' in ...)`
    // branch short-circuits before the extra get() runs — zero added cost
    // for every non-device session.
    function isAuthenticated() {
      return request.auth != null &&
        (!('deviceId' in request.auth.token) ||
          !get(/databases/$(database)/documents/devices/$(request.auth.token.deviceId)).data.get('revoked', false));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOwnerAccount() {
      return isAuthenticated() && request.auth.token.email == "chris.hardy.07@googlemail.com";
    }

    function isSuperAdmin() {
      return isOwnerAccount() || (isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Superadmin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true
      ));
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Shared-ownership helper for companies (and their subcollections/settings):
    // legacy (ownerless) companies stay visible to everyone during migration.
    function canAccessCompany(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return isAdmin() ||
        !('ownerId' in c) ||
        c.ownerId == "" ||
        request.auth.uid == c.ownerId ||
        request.auth.uid in c.sharedWith;
    }

    // Shared-ownership helper for pets (and their subcollections, e.g. dog
    // tags) — same model as canAccessCompany: legacy (ownerless) pets stay
    // visible to everyone during migration.
    function canAccessPet(petId) {
      let p = get(/databases/$(database)/documents/pets/$(petId)).data;
      return isAdmin() ||
        !('ownerId' in p) ||
        p.ownerId == "" ||
        request.auth.uid == p.ownerId ||
        request.auth.uid in p.sharedWith;
    }

    function canAccessHousehold(householdId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == householdId ||
        userDoc.householdId == householdId ||
        ('householdIds' in userDoc && householdId in userDoc.householdIds) ||
        (exists(/databases/$(database)/documents/households/$(householdId)) &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds)
      );
    }

    // Generic per-page individual sharing: pageShares/{ownerId}_{page}_{targetUid}
    // grants the target user "view" or "edit" access to one of the owner's
    // pages (finance, tasks, etc.) without touching household membership.
    function pageShareId(ownerId, page) {
      return ownerId + '_' + page + '_' + request.auth.uid;
    }

    function canViewPage(ownerId, page) {
      return isAuthenticated() && (
        isOwner(ownerId) ||
        isAdmin() ||
        exists(/databases/$(database)/documents/pageShares/$(pageShareId(ownerId, page)))
      );
    }

    function canEditPage(ownerId, page) {
      return isAuthenticated() && (
        isOwner(ownerId) ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/pageShares/$(pageShareId(ownerId, page))) &&
          get(/databases/$(database)/documents/pageShares/$(pageShareId(ownerId, page))).data.permission == "edit")
      );
    }

    // Users collection - users can read/write their own data, admins can manage all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(userId) || isAdmin();
      // Don't allow direct client writes to other users' docs unless they're admin.
      // Superadmin/admin actions should prefer Cloud Functions.
    }
    
    // Invites collection - only admins can manage
    match /invites/{inviteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Households - formal multi-membership entity. Any current member can read/
    // update (e.g. invite another member); only the creator or an admin can
    // delete the household itself.
    match /households/{householdId} {
      allow read, update: if isAuthenticated() && (
        isAdmin() || request.auth.uid in resource.data.memberIds
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.createdBy == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || request.auth.uid == resource.data.createdBy
      );
    }

    // Page shares - generic owner -> target grant (view/edit) for individual
    // pages (finance, tasks, etc). Doc id is deterministic: {ownerId}_{page}_{targetUid}.
    match /pageShares/{shareId} {
      allow read, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        shareId == request.resource.data.ownerId + '_' + request.resource.data.page + '_' + request.resource.data.targetUid;
      allow update: if isAuthenticated() && (
        isAdmin() || resource.data.ownerId == request.auth.uid
      );
    }

    // Family collection - authenticated users can read, owners can write
    match /families/{familyId} {
      allow read: if isAuthenticated() && 
        (resource.data.members[request.auth.uid] != null || 
         resource.data.admins[request.auth.uid] != null);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.admins[request.auth.uid] == true;
      
      // Family members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null;
        allow write: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.admins[request.auth.uid] == true;
      }
      
      // Family documents subcollection
      match /documents/{documentId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null;
        allow write: if isAuthenticated() && 
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null;
      }
    }
    
    // Shared documents - only accessible by specified users
    match /sharedDocuments/{documentId} {
      allow read: if isAuthenticated() && 
        (resource.data.sharedWith[request.auth.uid] != null || 
         isOwner(resource.data.ownerId));
      allow write: if isAuthenticated() && isOwner(resource.data.ownerId);
    }
    
    // Pets collection - per-user with optional sharing
    // Legacy pets (no ownerId) remain readable by all authenticated users during migration
    // Pets collection - owner + sharedWith, or a pets pageShare, or 35PFP legacy (no ownerId)
    match /pets/{petId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.sharedWith ||
        canViewPage(resource.data.ownerId, "pets")
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.sharedWith
      );
      allow delete: if isAuthenticated() && (
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId
      );

      // Dog tags — printable QR stickers for this pet. No public rule here:
      // the /tag/:tagId scan page (hit by strangers with no account) never
      // talks to Firestore directly, only through Cloud Functions using the
      // Admin SDK — see functions/src/dogTags.ts.
      match /tags/{tagId} {
        allow read, write: if isAuthenticated() && canAccessPet(petId);
      }
    }

    // Dog tag friendly URLs (hardyapp.co.uk/p/{slug}). Uniqueness is enforced
    // by this rule alone, not application code: allow create only requires
    // being signed in (no way to check ownership before the doc exists), but
    // once a slug is claimed, only its owner can update/delete it — so a
    // second attempt to write over an already-claimed slug is treated as an
    // update by Firestore (the doc now exists) and denied unless it's the
    // same owner. First write wins.
    match /dogTagSlugs/{slug} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // QR code friendly/auto-generated links (hardyapp.co.uk/l/{slug}). Same
    // first-write-wins uniqueness pattern as dogTagSlugs above, but public
    // read: unlike dog tags, resolution happens client-side (no Cloud
    // Function) by reading this doc directly from an anonymous scanner, and
    // the only data exposed is the redirect target — no more sensitive than
    // the QR code itself.
    match /qrLinkSlugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Finance - each user's personal accounts, shareable via pageShares
    match /finance/{userId}/accounts/{accountId} {
      allow read: if canViewPage(userId, "finance");
      allow write: if canEditPage(userId, "finance");
    }

    match /finance/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "finance");
      allow write: if canEditPage(userId, "finance");
    }

    // Weight tracking - per user, bundled into the "health" page share
    // (weight, medications, health profile & health documents share one grant)
    match /weightTracker/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/height/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/botox/{recordId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/bloodPressure/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /weightTracker/{userId}/measurements/{entryId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // Medications - per user, bundled into the "health" page share
    match /medications/{userId}/meds/{medId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }
    match /medications/{userId}/logs/{logId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // Notifications - per user
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Tattersalls - shared flat management data
    match /tattersalls/{docId} {
      allow read, write: if isAuthenticated();
      
      match /documents/{documentId} {
        allow read, write: if isAuthenticated();
      }
      
      match /notes/{noteId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Tasks - per user, shareable via pageShares
    match /tasks/{userId}/items/{taskId} {
      allow read: if canViewPage(userId, "tasks");
      allow write: if canEditPage(userId, "tasks");
    }

    // Task settings - strictly per user (not shared alongside the Tasks page)
    match /taskSettings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Credentials (login details vault) - strictly per user only
    match /users/{userId}/credentials/{credId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Companies - shared via ownerId + sharedWith, same model as pets.
    // Legacy companies (no ownerId) remain readable by all authenticated users during migration.
    match /companies/{companyId} {
      allow read, update: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.sharedWith
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == "" ||
        request.auth.uid == resource.data.ownerId
      );

      match /logins/{loginId} {
        allow read, write: if isAuthenticated() && canAccessCompany(companyId);
      }
      match /services/{serviceId} {
        allow read, write: if isAuthenticated() && canAccessCompany(companyId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isAuthenticated() && canAccessCompany(companyId);
      }
      match /insurance/{policyId} {
        allow read, write: if isAuthenticated() && canAccessCompany(companyId);
      }
      match /income/{incomeId} {
        allow read, write: if isAuthenticated() && canAccessCompany(companyId);
      }
      match /taxReturns/{returnId} {
        allow read, write: if isAuthenticated() && canAccessCompany(companyId);
      }
    }

    // Company settings (income/expense categories, tax rate) - same sharing model as companies
    match /companySettings/{companyId} {
      allow read, write: if isAuthenticated() && canAccessCompany(companyId);
    }

    // Household items - shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/items/{itemId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Household settings - shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/settings/{settingId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Freezer inventory - per user, shareable via pageShares
    match /freezer/{userId}/items/{itemId} {
      allow read: if canViewPage(userId, "freezer");
      allow write: if canEditPage(userId, "freezer");
    }

    // QR codes library - per user, shareable via pageShares
    match /qrcodes/{userId}/items/{qrId} {
      allow read: if canViewPage(userId, "qrcodes");
      allow write: if canEditPage(userId, "qrcodes");
    }

    // QR code settings - shared alongside the QR codes page
    match /qrcodes/{userId}/settings/{doc} {
      allow read: if canViewPage(userId, "qrcodes");
      allow write: if canEditPage(userId, "qrcodes");
    }

    // Calendar events - per user, shareable via pageShares
    match /calendar/{userId}/events/{eventId} {
      allow read: if canViewPage(userId, "calendar");
      allow write: if canEditPage(userId, "calendar");
    }

    // Calendar meta/settings - shared alongside the Calendar page
    match /calendar/{userId}/meta/{doc} {
      allow read: if canViewPage(userId, "calendar");
      allow write: if canEditPage(userId, "calendar");
    }

    // Annual leave - per user rotation periods & leave entries, shareable via pageShares
    match /annualLeave/{userId}/periods/{periodId} {
      allow read: if canViewPage(userId, "annual_leave");
      allow write: if canEditPage(userId, "annual_leave");
    }
    match /annualLeave/{userId}/entries/{entryId} {
      allow read: if canViewPage(userId, "annual_leave");
      allow write: if canEditPage(userId, "annual_leave");
    }

    // Substances config - TOTP setup per user - strictly private, never shared
    match /substancesConfig/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Health profile - demographics & medical history per user, bundled into the "health" page share
    match /healthProfile/{userId} {
      allow read: if canViewPage(userId, "health");
      allow write: if canEditPage(userId, "health");
    }

    // App-wide config (e.g. Gemini API key) - readable/writable by any authenticated user
    match /appConfig/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Custom health tabs - per user (previously had no rule at all, denying all access)
    match /healthTabs/{userId}/tabs/{tabId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /healthTabs/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Substance logs - per user
    match /substanceLogs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /logs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Cameras - shared by household membership, with owner-uid fallback for legacy data
    match /cameras/{householdId} {
      allow read, write: if canAccessHousehold(householdId);
      match /list/{camId} {
        allow read, write: if canAccessHousehold(householdId);
      }
    }

    // Household documents - shared by household membership, with owner-uid fallback for legacy data
    match /household/{householdId}/documents/{docId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // /display photo frame library - shared by household membership, same as household items/documents
    match /household/{householdId}/photos/{photoId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Joint household finance — shared with every household member (not personal finance/{uid})
    match /household/{householdId}/financeAccounts/{accountId} {
      allow read, write: if canAccessHousehold(householdId);
    }
    match /household/{householdId}/financeEntries/{entryId} {
      allow read, write: if canAccessHousehold(householdId);
    }

    // Notification preferences - per user
    match /notificationPrefs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Scheduled notifications - written by Cloud Functions; readable by owner
    match /scheduledNotifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // General document store - per user, shareable via pageShares
    match /documents/{userId}/items/{docId} {
      allow read: if canViewPage(userId, "documents");
      allow write: if canEditPage(userId, "documents");
    }

    // AI Analysis session history - strictly per user (uploaded documents can be sensitive)
    match /aiAnalysis/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Always-on display devices — a device authenticates as the real account
    // that paired/signed it in, so it can only ever touch its own doc here
    // (not create/read others'). Creation happens either client-side right
    // after the device's own sign-in (uid must match), or via the pairing
    // Cloud Functions using the Admin SDK, which bypasses these rules.
    match /devices/{deviceId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
